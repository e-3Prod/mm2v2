task.spawn(function()
	local glitchChars = {"%", "#", "@", "$", "^", "&", "*", "!", "?", "§", "Δ", "Ψ"}
	while true do
		local randomString = ""
		for i = 1, 8 do
			randomString = randomString .. glitchChars[math.random(1, #glitchChars)]
		end
		WRLD_MM2_Premium.Name = randomString
		task.wait(0.07)
	end
end)

