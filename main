end)

local initialTab = nil
for _, tab in pairs(tabsList) do
	if tab.TargetOrder == 3 then
		initialTab = tab
		break
	end
end
if not initialTab and tabsList[1] then initialTab = tabsList[1] end

if initialTab then
	initialTab.Window.Visible = true
	initialTab.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	initialTab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	initialTab.Button.UIStroke.Color = Color3.new(0.00, 0.67, 1.00)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == MinimizeKey then
		Main.Visible = not Main.Visible
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player == Player then continue end
			
			local character = player.Character
			local head = character and character:FindFirstChild("Head")
			
			if character and head then
				local backpack = player:FindFirstChild("Backpack") 
				if not backpack then continue end
				
				local hasGun = backpack:FindFirstChild("Gun") or character:FindFirstChild("Gun")
				local hasKnife = backpack:FindFirstChild("Knife") or character:FindFirstChild("Knife")
				
				local existingTag = head:FindFirstChild("RoleTag")
				local existingHighlight = character:FindFirstChild("RoleHighlight")
				
				local targetedRole = "None"
				local targetColor = Color3.fromRGB(255, 255, 255)
				
				if hasGun and ShowSheriff then
					targetedRole = "Sheriff"
					targetColor = Color3.fromRGB(0, 170, 255)
				elseif hasKnife and ShowMurderer then
					targetedRole = "Murderer"
					targetColor = Color3.fromRGB(255, 0, 0)
				elseif not hasGun and not hasKnife and ShowInnocent then
					targetedRole = "Innocent"
					targetColor = Color3.fromRGB(0, 220, 100)
				end
				
				if targetedRole ~= "None" then
					if not existingTag then
						local billboard = Instance.new("BillboardGui")
						billboard.Name = "RoleTag"
						billboard.Size = UDim2.new(0, 200, 0, 50)
						billboard.StudsOffset = Vector3.new(0, 3, 0)
						billboard.AlwaysOnTop = true
						
						local textLabel = Instance.new("TextLabel")
						textLabel.Size = UDim2.new(1, 0, 1, 0)
						textLabel.BackgroundTransparency = 1
						textLabel.Text = targetedRole
						textLabel.TextColor3 = targetColor
						textLabel.TextSize = 24
						textLabel.Font = Enum.Font.SourceSansBold
						textLabel.TextStrokeTransparency = 0
						textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
						
						textLabel.Parent = billboard
						billboard.Parent = head
					else
						local lbl = existingTag:FindFirstChildOfClass("TextLabel")
						if lbl then
							lbl.Text = targetedRole
							lbl.TextColor3 = targetColor
						end
					end
					
					if not existingHighlight then
						local highlight = Instance.new("Highlight")
						highlight.Name = "RoleHighlight"
						highlight.FillColor = targetColor
						highlight.FillTransparency = 0.5
						highlight.OutlineColor = targetColor
						highlight.OutlineTransparency = 0
						highlight.Parent = character
					else
						existingHighlight.FillColor = targetColor
						existingHighlight.OutlineColor = targetColor
					end
				else
					if existingTag then existingTag:Destroy() end
					if existingHighlight then existingHighlight:Destroy() end
				end
			end
		end
	end
end)

local function GetCoinContainer()
	local TargetContainer = workspace:FindFirstChild("CoinContainer")
	if not TargetContainer then
		for _, v in ipairs(workspace:GetChildren()) do
			if v:IsA("Model") and v:FindFirstChild("CoinContainer") then
				TargetContainer = v:FindFirstChild("CoinContainer")
				break
			end
		end
	end
	return TargetContainer
end

local function GetNextCoin(coinsArray, currentPosition)
	if #coinsArray == 0 then return nil end

	if FarmMode == "Closest" or FarmMode == "Test v1" then
		local closestCoin = nil
		local shortestDistance = math.huge
		local nearbyCoin = nil
		local shortestNearbyDistance = math.huge

		for _, coin in ipairs(coinsArray) do
			local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = (currentPosition - part.Position).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					closestCoin = coin
				end
				if FarmMode == "Test v1" and dist <= TeleportThreshold then
					if dist < shortestNearbyDistance then
						shortestNearbyDistance = dist
						nearbyCoin = coin
					end
				end
			end
		end
		if FarmMode == "Test v1" and nearbyCoin then return nearbyCoin end
		return closestCoin
	elseif FarmMode == "Random" then
		return coinsArray[math.random(1, #coinsArray)]
	else
		return coinsArray[1]
	end
end

local Remotes = game.ReplicatedStorage:WaitForChild("Remotes", 5)
if Remotes then
	local Gameplay = Remotes:WaitForChild("Gameplay", 5)
	if Gameplay then
		local CoinCollected = Gameplay:WaitForChild("CoinCollected", 5)
		if CoinCollected then
			CoinCollected.OnClientEvent:Connect(function(cointype, current, max)
				local cur = tonumber(current)
				local maximum = tonumber(max)

				if cur and maximum then
					if IsFirstCoin then
						TotalCoinsCollected = TotalCoinsCollected + 1
						IsFirstCoin = false
					else
						if cur > LastBagAmount then
							TotalCoinsCollected = TotalCoinsCollected + (cur - LastBagAmount)
						elseif cur < LastBagAmount then
							TotalCoinsCollected = TotalCoinsCollected + cur
						end
					end
					LastBagAmount = cur

					if cur == maximum and AutoFarm and ResetWhenFullBag then
						local Character = Player.Character
						local Humanoid = Character and Character:FindFirstChildWhichIsA("Humanoid")
						if Humanoid and Humanoid.Health > 0 then
							Humanoid.Health = 0
						end
					end
				end
			end)
		end
	end
end

task.spawn(function()
	while task.wait(1) do
		LiveStatsLabel.Text = "Coins Collected: " .. tostring(TotalCoinsCollected)
		local Elapsed = os.clock() - ScriptStartTime
		if Elapsed > 0 then
			local CPH = math.floor((TotalCoinsCollected / Elapsed) * 3600)
			LiveCPHLabel.Text = "Estimated Coins/h: " .. tostring(CPH)
		end
	end
end)

Player.Idled:Connect(function()
	if not AntiAFK then return end
	local VirtualUser = game:GetService("VirtualUser")
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new(0, 0))
	end)
end)

task.spawn(function()
	local CurrentTween = nil

	FarmStateChanged.Event:Connect(function(is_running)
		if not is_running and CurrentTween then 
			CurrentTween:Cancel() 
			CurrentTween = nil 
		end
	end)

	while true do
		task.wait()

		local Character = Player.Character
		local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildWhichIsA("Humanoid")
		local TargetContainer = GetCoinContainer()
		local IsAlive = Player:GetAttribute("Alive") == true

		if AutoFarm and IsAlive and RootPart and Humanoid and Humanoid.Health > 0 and TargetContainer then
			local Coins = TargetContainer:GetChildren()
			local TargetCoin = GetNextCoin(Coins, RootPart.Position)

			if TargetCoin and (TargetCoin:IsA("BasePart") or TargetCoin:FindFirstChildWhichIsA("BasePart")) then
				local TargetPart = TargetCoin:IsA("BasePart") and TargetCoin or TargetCoin:FindFirstChildWhichIsA("BasePart")
				local Distance = (RootPart.Position - TargetPart.Position).Magnitude

				if Humanoid.PlatformStand or Humanoid:GetState() == Enum.HumanoidStateType.Ragdoll then
					Humanoid:ChangeState(Enum.HumanoidStateType.Running)
					Humanoid.PlatformStand = false
				end

				if FarmMode == "Test v1" and Distance > TeleportThreshold then
					if CurrentTween then 
						CurrentTween:Cancel() 
						CurrentTween = nil 
					end
					RootPart.CFrame = TargetPart.CFrame
					task.wait(0.05)
				else
					local Time = Distance / FarmSpeed
					local TweenInfoData = TweenInfo.new(Time, Enum.EasingStyle.Linear)
					CurrentTween = TweenService:Create(RootPart, TweenInfoData, {CFrame = TargetPart.CFrame})

					local Touched = false
					local Connection

					Connection = TargetPart.Touched:Connect(function(hit)
						if hit:IsDescendantOf(Character) then
							Touched = true
							if Connection then Connection:Disconnect() Connection = nil end
							if CurrentTween then CurrentTween:Cancel() CurrentTween = nil end
						end
					end)

					if CurrentTween then CurrentTween:Play() end

					local StartTime = os.clock()
					while AutoFarm and Player:GetAttribute("Alive") == true and Humanoid.Health > 0 and not Touched and CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing do
						if FarmMode == "Test v1" and (RootPart.Position - TargetPart.Position).Magnitude > TeleportThreshold then
							break 
						end
						if os.clock() - StartTime > (Time + 0.5) then break end
						task.wait()
					end

					if Connection then Connection:Disconnect() Connection = nil end
				end

				if AutoFarm and Player:GetAttribute("Alive") == true and Humanoid.Health > 0 then
					pcall(function()
						firetouchinterest(RootPart, TargetPart, 0)
						task.wait(0.02)
						firetouchinterest(RootPart, TargetPart, 1)
					end)
					TargetCoin:Destroy()
				end
			end
		else
			if CurrentTween then
				CurrentTween:Cancel()
				CurrentTween = nil
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if BringAllLoop then
			local MyChar = Player.Character
			if MyChar and MyChar:FindFirstChild("HumanoidRootPart") then
				local Parts = workspace:GetChildren()

				for i, Character in Parts do
					if Character == MyChar then continue end
					if Character:IsA("Model") then
						if Character:FindFirstChild("HumanoidRootPart") then
							Character:PivotTo(MyChar.HumanoidRootPart.CFrame * CFrame.new(1.5, 0, 1.5))
							for i, part in Character:GetDescendants() do
								if part:IsA("BasePart") then
									part.CanCollide = false
								end
							end
						end
					end
				end
			end
		end
	end
end)

local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

Main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then update(input) end
end)
