local function AddPlayerScroller(parentTab, callback)
	local MainFrame = Instance.new("Frame")
	MainFrame.Size = UDim2.new(0.94, 0, 0, 160)
	MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
	MainFrame.Parent = parentTab

	Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
	local Stroke = Instance.new("UIStroke", MainFrame)
	Stroke.Color = Color3.fromRGB(30, 30, 30)

	local Scroller = Instance.new("ScrollingFrame", MainFrame)
	Scroller.Size = UDim2.new(1, -12, 1, -12)
	Scroller.Position = UDim2.new(0, 6, 0, 6)
	Scroller.BackgroundTransparency = 1
	Scroller.BorderSizePixel = 0
	Scroller.ScrollBarThickness = 4
	Scroller.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70)
	Scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scroller.CanvasSize = UDim2.new(0, 0, 0, 0)

	local List = Instance.new("UIListLayout", Scroller)
	List.Padding = UDim.new(0, 5)
	List.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local function Refresh()
		for _, item in ipairs(Scroller:GetChildren()) do
			if item:IsA("TextButton") then item:Destroy() end
		end

		for _, p in ipairs(Players:GetPlayers()) do
			if p == Player then continue end
			local PBtn = Instance.new("TextButton")
			PBtn.Size = UDim2.new(0.98, 0, 0, 28)
			PBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
			PBtn.TextColor3 = Color3.fromRGB(210, 210, 210)
			PBtn.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"
			PBtn.TextSize = 12
			PBtn.TextXAlignment = Enum.TextXAlignment.Left
			PBtn.FontFace = Font.new("rbxasset://fonts/families/ComicNeueAngular.json", Enum.FontWeight.Medium)
			PBtn.Parent = Scroller
			
			Instance.new("UICorner", PBtn).CornerRadius = UDim.new(0, 4)
			local BStroke = Instance.new("UIStroke", PBtn)
			BStroke.Color = Color3.fromRGB(40, 40, 40)

			PBtn.MouseButton1Click:Connect(function()
				callback(p)
			end)
		end
	end

	Refresh()
	Players.PlayerAdded:Connect(Refresh)
	Players.PlayerRemoving:Connect(Refresh)
end

local GeneralTab  = CreateTab("General", 3)
local TrollTab    = CreateTab("Troll", 4)
local AutofarmTab = CreateTab("Autofarm", 5)
local MiscTab     = CreateTab("Misc", 6)

local function FindGunDrop()
	for _, object in ipairs(workspace:GetDescendants()) do
		if object.Name == "GunDrop" or object.Name == "Gun Drop" then
			if object:IsA("BasePart") then
				return object
			elseif object:IsA("Model") then
				return object:FindFirstChildWhichIsA("BasePart") or object.PrimaryPart
			end
		end
	end
	return nil
end

local function TeleportToGunDrop()
	local gunPart = FindGunDrop()
	local character = Player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	if gunPart and rootPart then
		LastGunTeleportCFrame = rootPart.CFrame
		rootPart.CFrame = gunPart.CFrame

		task.spawn(function()
			repeat
				task.wait(0.05)
			until not FindGunDrop()

			if rootPart and rootPart.Parent and LastGunTeleportCFrame then
				rootPart.CFrame = LastGunTeleportCFrame
			end
		end)
	end
end

AddToggle(GeneralTab, "ESP Innocent", function(state)
	ShowInnocent = state
end)

AddToggle(GeneralTab, "ESP Murderer", function(state)
	ShowMurderer = state
end)

AddToggle(GeneralTab, "ESP Sheriff", function(state)
	ShowSheriff = state
end)

AddToggle(GeneralTab, "Kill Everyone (Murderer Only)", function(state)
	BringAllLoop = state
end)

AddButton(GeneralTab, "🎯 Teleport to Gun Drop", TeleportToGunDrop)

AddToggle(GeneralTab, "🔄 Auto Teleport to Gun Drop", function(state)
	AutoTpGun = state
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if AutoTpGun then
			local gunPart = FindGunDrop()
			local character = Player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if gunPart and rootPart then
				rootPart.CFrame = gunPart.CFrame
			end
		end
	end
end)

local function BackendFling(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return end
	local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	local localChar = Player.Character
	local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local localHum = localChar and localChar:FindFirstChildWhichIsA("Humanoid")
	
	if not targetRoot or not localRoot or not localHum then return end
	
	local oldCFrame = localRoot.CFrame
	local flingActive = true
	
	local bV = Instance.new("BodyVelocity")
	bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bV.Velocity = Vector3.new(99999, 99999, 99999)
	bV.Parent = localRoot
	
	local bAV = Instance.new("BodyAngularVelocity")
	bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bAV.P = 150000
	bAV.AngularVelocity = Vector3.new(99999, 99999, 99999)
	bAV.Parent = localRoot
	
	localHum:ChangeState(Enum.HumanoidStateType.Physics)
	
	task.spawn(function()
		local startTime = os.clock()
		while flingActive and os.clock() - startTime < 3.0 do
			if not targetPlayer.Parent or not targetPlayer.Character or not targetRoot or not localRoot or not localHum or localHum.Health <= 0 then break end
			
			for _, part in ipairs(localChar:GetDescendants()) do
				if part:IsA("BasePart") then 
					part.CanCollide = false 
				end
			end
			
			local targetVelocity = targetRoot.Velocity
			local predictionOffset = targetVelocity * 0.12
			
			local frameTick = (os.clock() * 50) % 4
			local finalOffset = Vector3.new(0, 0, 0)
			
			if frameTick < 1 then
				finalOffset = Vector3.new(1.2, 0, 1.2)
			elseif frameTick < 2 then
				finalOffset = Vector3.new(-1.2, 0, -1.2)
			elseif frameTick < 3 then
				finalOffset = Vector3.new(1.2, -0.5, -1.2)
			else
				finalOffset = Vector3.new(-1.2, 0.5, 1.2)
			end
			
			localRoot.CFrame = CFrame.new(targetRoot.Position + predictionOffset + finalOffset)
			
			task.wait()
		end
		
		flingActive = false
		if bV then bV:Destroy() end
		if bAV then bAV:Destroy() end
		
		if localRoot then
			localRoot.Velocity = Vector3.zero
			localRoot.RotVelocity = Vector3.zero
			task.wait(0.05)
			localRoot.CFrame = oldCFrame
		end
		
		if localHum then
			localHum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

local function FlingMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p == Player then continue end
		local char = p.Character
		if char and (p.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")) then
			BackendFling(p)
			break
		end
	end
end

local function FlingSheriff()
	for _, p in ipairs(Players:GetPlayers()) do
		if p == Player then continue end
		local char = p.Character
		if char and (p.Backpack:FindFirstChild("Gun") or char:FindFirstChild("Gun")) then
			BackendFling(p)
			break
		end
	end
end

AddButton(TrollTab, "⚡ Fling Murderer", FlingMurderer)
