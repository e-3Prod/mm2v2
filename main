local function AddKeybind(parentTab, labelText, defaultKey, callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(0.94, 0, 0, 44)
	Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
	Frame.Parent = parentTab

	Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
	local Stroke = Instance.new("UIStroke", Frame)
	Stroke.Color = Color3.fromRGB(35, 35, 35)

	local Label = Instance.new("TextLabel", Frame)
	Label.Size = UDim2.new(0.5, 0, 1, 0)
	Label.Position = UDim2.new(0, 12, 0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = labelText
	Label.TextColor3 = Color3.fromRGB(220, 220, 220)
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.FontFace = Font.new("rbxasset://fonts/families/ComicNeueAngular.json", Enum.FontWeight.Medium)

	local Btn = Instance.new("TextButton", Frame)
	Btn.Size = UDim2.new(0, 100, 0, 28)
	Btn.Position = UDim2.new(1, -112, 0.5, -14)
	Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	Btn.TextColor3 = Color3.new(0.00, 0.67, 1.00)
	Btn.TextSize = 13
	Btn.Text = defaultKey.Name
	Btn.FontFace = Font.new("rbxasset://fonts/families/ComicNeueAngular.json", Enum.FontWeight.Bold)
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

	local isListening = false
	Btn.MouseButton1Click:Connect(function()
		if isListening then return end
		isListening = true
		Btn.Text = "..."
		
		local connection
		connection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				isListening = false
				Btn.Text = input.KeyCode.Name
				callback(input.KeyCode)
				connection:Disconnect()
			end
		end)
	end)
end

