local tabsList = {}

local function CreateTab(tabName, layoutOrder)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Name = tabName .. "Btn"
	TabBtn.BackgroundColor3 = Color3.new(0.06, 0.06, 0.06)
	TabBtn.FontFace = Font.new("rbxasset://fonts/families/ComicNeueAngular.json", Enum.FontWeight.SemiBold, Enum.FontStyle.Normal)
	TabBtn.TextSize = 14
	TabBtn.Size = UDim2.new(0, 130, 0, 32)
	TabBtn.TextColor3 = Color3.new(0.63, 0.63, 0.63)
	TabBtn.Text = "  " .. tabName
	TabBtn.TextXAlignment = Enum.TextXAlignment.Left
	TabBtn.LayoutOrder = layoutOrder or 0
	TabBtn.Parent = SideBar

	local UICorner_Btn = Instance.new("UICorner")
	UICorner_Btn.CornerRadius = UDim.new(0, 6)
	UICorner_Btn.Parent = TabBtn

	local UIStroke_Btn = Instance.new("UIStroke")
	UIStroke_Btn.Color = Color3.new(0.12, 0.12, 0.12)
	UIStroke_Btn.Parent = TabBtn

	local TabWindow = Instance.new("ScrollingFrame")
	TabWindow.Name = tabName .. "Window"
	TabWindow.Size = UDim2.new(1, 0, 1, 0)
	TabWindow.BackgroundTransparency = 1
	TabWindow.BorderSizePixel = 0
	TabWindow.ScrollBarThickness = 3
	TabWindow.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
	TabWindow.AutomaticCanvasSize = Enum.AutomaticSize.Y
	TabWindow.CanvasSize = UDim2.new(0, 0, 0, 0)
	TabWindow.Visible = false
	TabWindow.Parent = TabContainer

	local WindowList = Instance.new("UIListLayout")
	WindowList.Padding = UDim.new(0, 8)
	WindowList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	WindowList.Parent = TabWindow

	local WindowPadding = Instance.new("UIPadding")
	WindowPadding.PaddingTop = UDim.new(0, 15)
	WindowPadding.Parent = TabWindow

	TabBtn.MouseButton1Click:Connect(function()
		for _, tab in pairs(tabsList) do
			tab.Window.Visible = false
			TweenService:Create(tab.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 15, 15), TextColor3 = Color3.fromRGB(160, 160, 160)}):Play()
			tab.Button.UIStroke.Color = Color3.fromRGB(30, 30, 30)
		end
		TabWindow.Visible = true
		TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		TabBtn.UIStroke.Color = Color3.new(0.00, 0.67, 1.00)
	end)

	table.insert(tabsList, {Button = TabBtn, Window = TabWindow, TargetOrder = layoutOrder})
	return TabWindow
end

local function AddButton(parentTab, text, callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(0.94, 0, 0, 44)
	Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
